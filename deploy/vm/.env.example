# Copy to .env on the VM with mode 0600. Values here are placeholders only.
PRIVATE_API_HOST=staging-api.example.test
PRIVATE_PROXY_SECRET=replace-with-64-random-hex-characters
POSTGRES_DB=gamescout
POSTGRES_USER=gamescout
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://gamescout:replace-with-url-encoded-password@postgres:5432/gamescout
PUBLIC_ORIGIN=https://gamescout.online
PUBLIC_CATALOG_ORIGIN=https://gamescout.online
PUBLIC_PROJECTION_URL=https://gamescout.online/api/internal/public-projection
PUBLIC_PROJECTION_SECRET=replace-with-existing-public-projection-secret
MAIL_ENCRYPTION_KEY=replace-with-64-random-hex-characters
RATE_HASH_KEY=replace-with-64-random-hex-characters
MAIL_DRIVER=disabled
# Mail by SMTP from an ordinary mailbox (Yandex, Mail.ru, Gmail) with an APP password:
# MAIL_DRIVER=smtp
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=465
# SMTP_USER=gamescout@yandex.ru
# SMTP_PASSWORD=replace-with-the-app-password
# MAIL_FROM=GameScout <gamescout@yandex.ru>
ENABLE_TEST_PAYMENTS=0
