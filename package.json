{
  "name": "gamescout",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:private": "node private-api/serve.mjs --local",
    "db:private-plan": "node private-api/migrate-cli.mjs --plan",
    "db:private-apply": "node private-api/migrate-cli.mjs --apply",
    "private:maintenance-once": "node private-api/maintenance-once.mjs",
    "dev:core-ui": "node scripts/dev-core-ui.mjs",
    "test:private": "node --test tests/private-core.test.mjs tests/projection-backfill.test.mjs tests/egress.test.mjs tests/emergency.test.mjs tests/telegram-relay.test.mjs tests/telegram-relay-runtime.test.mjs tests/claim-proof.test.mjs",
    "test:seo": "node tests/seo-http.mjs",
    "seo:reconcile": "node scripts/reconcile-public-html.mjs",
    "dev": "vite",
    "build": "npm run typecheck && node scripts/sitemap.mjs && vite build && node scripts/prerender-public.mjs",
    "build:catalog": "node scripts/build-from-catalog.mjs",
    "preview": "vite preview --port 4173",
    "dev:api": "node scripts/setup-dev.mjs && wrangler dev --local --ip 127.0.0.1 --port 8787 --local-upstream 127.0.0.1:8787 --persist-to .wrangler/state",
    "dev:setup": "node scripts/setup-dev.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:reset": "node scripts/reset.mjs",
    "typecheck": "tsc -b && tsc -p tsconfig.worker.json",
    "test:adapters": "node --experimental-strip-types --test tests/adapters*.test.mjs",
    "dev:publish": "node scripts/publish.mjs",
    "dev:site": "node scripts/dev-site.mjs",
    "test:bundle": "node scripts/check-bundle.mjs",
    "test:api": "node tests/api.mjs && node tests/owner.mjs && node tests/accounts.mjs",
    "test:monitoring": "node tests/monitoring.mjs",
    "test:proxy": "node --test tests/proxy-readonly.test.mjs && node tests/proxy.mjs",
    "mirror:build": "node ru-proxy/build.mjs --noindex",
    "import:check": "node scripts/import-servers.mjs --check",
    "import:servers": "node scripts/import-servers.mjs",
    "import:probe": "node --experimental-strip-types scripts/probe-check.mjs",
    "test:import": "node --test tests/import-dataset.test.mjs && node tests/import.mjs"
  },
  "dependencies": {
    "hono": "^4.13.8",
    "lucide-react": "^1.47.0",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fontsource/cormorant-sc": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.136.1"
  }
}
